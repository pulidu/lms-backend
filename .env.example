# -----------------------------------------------------------------------------
# LMS Backend - Environment Variable Reference
# Safe example values only. Never commit real credentials.
# -----------------------------------------------------------------------------

# Server
PORT=5003
NODE_ENV=development

# MongoDB Atlas connection string (Mongoose)
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT signing secrets (use long random strings in production)
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# Frontend origin used to build verification / password-reset email links
FRONTEND_URL=http://localhost:5173

# Authentication Feature Toggles
# false = Direct login using Email + Password
# true  = Login requires Email + Password + OTP verification (Default if missing or invalid)
EMAIL_OTP_REQUIRED=false

# SMTP email settings (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email_address
EMAIL_PASS=your_smtp_app_password

# Google Generative AI (Gemini) - optional, used by the AI student assistant
GEMINI_API_KEY=your_google_ai_api_key